# Copy to a protected local .env.beta file and create all secret files first.
TWCLONE_POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres-admin.password
TWCLONE_APP_DB_PASSWORD_FILE=./secrets/runtime-db.password
TWCLONE_ADMIN_PGPASS_FILE=./secrets/migrator.pgpass
TWCLONE_APP_PGPASS_FILE=./secrets/runtime.pgpass
TWCLONE_BETA_TLS_CERT_FILE=./secrets/beta.crt
TWCLONE_BETA_TLS_KEY_FILE=./secrets/beta.key
