# Copy to a protected local .env.beta file and create all secret files first.
# For file-backed Compose secrets on Linux, keep the containing directory
# mode 0700. Docker bind-mounts preserve file permissions. The runtime UID/GID
# is 10001:10001: public certificate 0644, private key 0640 root:10001,
# runtime-role password 0640 root:10002 (DB supplemental group), and admin
# password/passfiles 0640 root:10001. Entrypoints copy passfiles to mode 0600.
TWCLONE_POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres-admin.password
TWCLONE_APP_DB_PASSWORD_FILE=./secrets/runtime-db.password
TWCLONE_ADMIN_PGPASS_FILE=./secrets/migrator.pgpass
TWCLONE_APP_PGPASS_FILE=./secrets/runtime.pgpass
TWCLONE_BETA_TLS_CERT_FILE=./secrets/game.crt
TWCLONE_BETA_TLS_KEY_FILE=./secrets/game.key
# Keep loopback for a local rehearsal; set 0.0.0.0 only on the approved
# public game host, where the firewall permits the game TCP/TLS port.
TWCLONE_BETA_HOST_ADDRESS=127.0.0.1
TWCLONE_BETA_HOST_PORT=12483
