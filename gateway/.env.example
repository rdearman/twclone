# Local HTTP development only. Use Secure cookies behind HTTPS in production.
GATEWAY_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=info
GATEWAY_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
GATEWAY_CORS_ORIGINS=
GATEWAY_PUBLIC_ORIGIN=http://localhost:4200
GATEWAY_SESSION_COOKIE_NAME=twclone_session
GATEWAY_SESSION_COOKIE_SECURE=false
GATEWAY_SESSION_COOKIE_SAMESITE=lax

# Private fixed upstream; never accept these values from browser requests.
TWCLONE_SERVER_HOST=127.0.0.1
TWCLONE_SERVER_PORT=1234
TWCLONE_SERVER_TIMEOUT_SECONDS=5
