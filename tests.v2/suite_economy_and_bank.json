{
  "name": "Economy & Bank Regression",
  "version": "2.0.0",
  "protocol_category": "26_Banking",
  "description": "Coverage for bank transactions, deposits, withdrawals",
  "tests": [
    {
      "name": "Setup: Admin fixtures",
      "setup": "macro_bootstrap_admin"
    },
    {
      "name": "Setup: User",
      "setup": "macro_auth_user",
      "username": "bank_user",
      "password": "password"
    },
    {
      "name": "Setup: Target User",
      "setup": "macro_auth_user",
      "username": "bank_target",
      "password": "password"
    },
    {
      "name": "Fixture: isolate standing orders for repeatable listing",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "DELETE FROM bank_orders WHERE player_id = (SELECT player_id FROM players WHERE name = 'bank_user')"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank Balance (Initial)",
      "command": "bank.balance",
      "user": "bank_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank Deposit (Success)",
      "command": "bank.deposit",
      "data": { "amount": 100 },
      "user": "bank_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Fixture: make petty cash insufficient for the negative deposit",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "UPDATE players SET credits = 100 WHERE name = 'bank_user'"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank Deposit (Insufficient Petty Cash)",
      "command": "bank.deposit",
      "data": { "amount": 1000000 },
      "user": "bank_user",
      "expect": { "error_code": 1403 }
    },
    {
      "name": "Bank Deposit rejects non-positive amount",
      "command": "bank.deposit",
      "data": { "amount": 0 },
      "user": "bank_user",
      "expect": { "status": "error", "error_code": 405 }
    },
    {
      "name": "Bank Withdraw (Success)",
      "command": "bank.withdraw",
      "data": { "amount": 50 },
      "user": "bank_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Fixture: clear the bank balance for the negative withdrawal",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "UPDATE bank_accounts SET balance = 100 WHERE owner_type = 'player' AND owner_id = (SELECT player_id FROM players WHERE name = 'bank_user') AND is_active = TRUE"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank Withdraw (Insufficient Bank Funds)",
      "command": "bank.withdraw",
      "data": { "amount": 1000000 },
      "user": "bank_user",
      "expect": { "error_code": 1403 }
    },
    {
      "name": "Bank Withdraw rejects non-positive amount",
      "command": "bank.withdraw",
      "data": { "amount": 0 },
      "user": "bank_user",
      "expect": { "status": "error", "error_code": 400 }
    },
    {
      "name": "Bank Transfer (Success)",
      "command": "bank.transfer",
      "data": { "recipient_type": "player", "recipient_id": "@bank_target_player_id", "amount": 10 },
      "user": "bank_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank Transfer (Insufficient Funds)",
      "command": "bank.transfer",
      "data": { "recipient_type": "player", "recipient_id": "@bank_target_player_id", "amount": 1000000 },
      "user": "bank_user",
      "expect": { "error_code": 1403 }
    },
    {
      "name": "Bank Transfer rejects non-positive amount",
      "command": "bank.transfer",
      "data": { "recipient_type": "player", "recipient_id": "@bank_target_player_id", "amount": 0 },
      "user": "bank_user",
      "expect": { "status": "error", "error_code": 400 }
    },
    {
      "name": "Create a daily standing order",
      "command": "bank.orders.create",
      "data": { "recipient_player_id": "@bank_target_player_id", "amount": 25, "frequency": "daily", "time_utc": "23:59" },
      "user": "bank_user",
      "save": { "bank_order_id": "data.order_id" },
      "asserts": [
        { "path": "data.amount", "op": "==", "value": 25 },
        { "path": "data.frequency", "op": "==", "value": "daily" }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Persist daily UTC time and existing-player recipient",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "SELECT CASE WHEN frequency='daily' AND utc_hour=23 AND utc_minute=59 AND to_entity='player' AND to_id=@{bank_target_player_id} THEN 1 ELSE 0 END FROM bank_orders WHERE bank_orders_id=@{bank_order_id};" },
      "user": "admin",
      "expect": { "status": "ok" },
      "asserts": [ { "path": "data.rows.0.0", "op": "==", "value": 1 } ]
    },
    {
      "name": "List only the authenticated player's standing order",
      "command": "bank.orders.list",
      "data": { "page": 1, "limit": 20 },
      "user": "bank_user",
      "asserts": [
        { "path": "data.orders.0.order_id", "op": "==", "value": "@{bank_order_id}" },
        { "path": "data.orders.0.recipient_player_id", "op": "==", "value": "@bank_target_player_id" }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Cancel the standing order",
      "command": "bank.orders.cancel",
      "data": { "order_id": "@{bank_order_id}" },
      "user": "bank_user",
      "asserts": [ { "path": "data.cancelled", "op": "==", "value": true } ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Another player cannot cancel a standing order",
      "command": "bank.orders.cancel",
      "data": { "order_id": "@{bank_order_id}" },
      "user": "bank_target",
      "expect": { "status": "error" }
    },
    {
      "name": "Create a weekly standing order at the requested UTC time",
      "command": "bank.orders.create",
      "data": { "recipient_player_id": "@bank_target_player_id", "amount": 10, "frequency": "weekly", "time_utc": "12:30", "weekday": 1 },
      "user": "bank_user",
      "asserts": [
        { "path": "data.frequency", "op": "==", "value": "weekly" },
        { "path": "data.time_utc", "op": "==", "value": "12:30" }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Persist weekly UTC time, ISO weekday and existing-player recipient",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "SELECT CASE WHEN frequency='weekly' AND utc_hour=12 AND utc_minute=30 AND weekday=1 AND to_entity='player' AND to_id=@{bank_target_player_id} THEN 1 ELSE 0 END FROM bank_orders WHERE bank_orders_id=(SELECT MAX(bank_orders_id) FROM bank_orders WHERE player_id=@{bank_user_player_id});" },
      "user": "admin",
      "expect": { "status": "ok" },
      "asserts": [ { "path": "data.rows.0.0", "op": "==", "value": 1 } ]
    },
    {
      "name": "Create Sunday weekly standing order using ISO weekday 7",
      "command": "bank.orders.create",
      "data": { "recipient_player_id": "@bank_target_player_id", "amount": 10, "frequency": "weekly", "time_utc": "12:30", "weekday": 7 },
      "user": "bank_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Persist ISO Sunday as weekday 7",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "SELECT CASE WHEN frequency='weekly' AND weekday=7 AND utc_hour=12 AND utc_minute=30 THEN 1 ELSE 0 END FROM bank_orders WHERE bank_orders_id=(SELECT MAX(bank_orders_id) FROM bank_orders WHERE player_id=@{bank_user_player_id});" },
      "user": "admin",
      "expect": { "status": "ok" },
      "asserts": [ { "path": "data.rows.0.0", "op": "==", "value": 1 } ]
    },
    {
      "name": "Reject weekly weekday zero outside ISO numbering",
      "command": "bank.orders.create",
      "data": { "recipient_player_id": "@bank_target_player_id", "amount": 10, "frequency": "weekly", "time_utc": "12:30", "weekday": 0 },
      "user": "bank_user",
      "expect": { "status": "error" }
    },
    {
      "name": "Reject weekly weekday eight outside ISO numbering",
      "command": "bank.orders.create",
      "data": { "recipient_player_id": "@bank_target_player_id", "amount": 10, "frequency": "weekly", "time_utc": "12:30", "weekday": 8 },
      "user": "bank_user",
      "expect": { "status": "error" }
    },
    {
      "name": "Create a monthly standing order retaining day 31",
      "command": "bank.orders.create",
      "data": { "recipient_player_id": "@bank_target_player_id", "amount": 10, "frequency": "monthly", "time_utc": "08:15", "day_of_month": 31 },
      "user": "bank_user",
      "asserts": [
        { "path": "data.frequency", "op": "==", "value": "monthly" },
        { "path": "data.next_run_at", "op": ">", "value": 0 }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Persist monthly UTC time, retained day 31 and existing-player recipient",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "SELECT CASE WHEN frequency='monthly' AND utc_hour=8 AND utc_minute=15 AND month_day=31 AND to_entity='player' AND to_id=@{bank_target_player_id} THEN 1 ELSE 0 END FROM bank_orders WHERE bank_orders_id=(SELECT MAX(bank_orders_id) FROM bank_orders WHERE player_id=@{bank_user_player_id});" },
      "user": "admin",
      "expect": { "status": "ok" },
      "asserts": [ { "path": "data.rows.0.0", "op": "==", "value": 1 } ]
    },
    {
      "name": "Unauthenticated standing-order listing is refused",
      "command": "bank.orders.list",
      "expect": { "status": "error", "error_code": 401 }
    },
    {
      "name": "Standing-order create request schema is discoverable",
      "command": "system.describe_schema",
      "data": { "name": "bank.orders.create", "type": "command" },
      "user": "bank_user",
      "asserts": [
        { "path": "data.schema.properties.frequency.enum.0", "op": "==", "value": "daily" },
        { "path": "data.schema.properties.time_utc.type", "op": "==", "value": "string" },
        { "path": "data.schema.properties.day_of_month.maximum", "op": "==", "value": 31 }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank History",
      "command": "bank.history",
      "user": "bank_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank transfer request schema is discoverable",
      "command": "system.describe_schema",
      "data": { "name": "bank.transfer", "type": "command" },
      "user": "bank_user",
      "asserts": [
        { "path": "data.schema.properties.amount.type", "op": "==", "value": "integer" },
        { "path": "data.schema.properties.to_player_id.type", "op": "==", "value": "integer" },
        { "path": "data.schema.properties.recipient_id.type", "op": "==", "value": "integer" }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank deposit request schema is discoverable",
      "command": "system.describe_schema",
      "data": { "name": "bank.deposit", "type": "command" },
      "user": "bank_user",
      "asserts": [
        { "path": "data.schema.properties.amount.type", "op": "==", "value": "integer" },
        { "path": "data.schema.required.0", "op": "==", "value": "amount" }
      ],
      "expect": { "status": "ok" }
    },
    {
      "name": "Bank withdraw request schema is discoverable",
      "command": "system.describe_schema",
      "data": { "name": "bank.withdraw", "type": "command" },
      "user": "bank_user",
      "asserts": [
        { "path": "data.schema.properties.amount.type", "op": "==", "value": "integer" },
        { "path": "data.schema.required.0", "op": "==", "value": "amount" }
      ],
      "expect": { "status": "ok" }
    }
  ]
}
