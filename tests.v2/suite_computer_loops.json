{
  "test_suite_name": "Computer Trade Loops Knowledge",
  "description": "Validates that trade loops are only recommended after docking at ports",
  "tests": [
    {
      "name": "Setup: Admin",
      "setup": "macro_bootstrap_admin"
    },
    {
      "name": "Register loop_player",
      "command": "auth.register",
      "user": "loop_player",
      "register_if_missing": true,
      "data": {
        "username": "loop_player",
        "passwd": "password"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Login loop_player",
      "command": "auth.login",
      "user": "loop_player",
      "data": {
        "username": "loop_player",
        "passwd": "password"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Initial Route Request (Empty)",
      "command": "player.computer.recommend_routes",
      "user": "loop_player",
      "data": {},
      "expect": {
        "status": "ok",
        "data": {
          "routes": []
        }
      }
    },
    {
      "name": "Choose a connected two-way port pair",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "SELECT p1.port_id, p1.sector_id, p2.port_id, p2.sector_id FROM sector_warps sw JOIN ports p1 ON p1.sector_id = sw.from_sector JOIN ports p2 ON p2.sector_id = sw.to_sector AND p2.port_id > p1.port_id JOIN port_trade pt1 ON pt1.port_id = p1.port_id JOIN port_trade pt2 ON pt2.port_id = p2.port_id AND pt2.commodity = pt1.commodity GROUP BY p1.port_id, p1.sector_id, p2.port_id, p2.sector_id, pt1.commodity HAVING SUM(CASE WHEN pt1.mode = 'sell' AND pt2.mode = 'buy' THEN 1 ELSE 0 END) > 0 AND SUM(CASE WHEN pt2.mode = 'sell' AND pt1.mode = 'buy' THEN 1 ELSE 0 END) > 0 ORDER BY p1.port_id, p2.port_id LIMIT 1"
      },
      "save": {
        "route_port_a_id": "data.rows.0.0",
        "route_sector_a_id": "data.rows.0.1",
        "route_port_b_id": "data.rows.0.2",
        "route_sector_b_id": "data.rows.0.3"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Move test player and ship to the selected first port",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "WITH target AS (SELECT player_id, ship_id FROM players WHERE name = 'loop_player'), known AS (DELETE FROM player_known_ports WHERE player_id = (SELECT player_id FROM target)), moved AS (UPDATE players p SET sector_id = @{route_sector_a_id} FROM target WHERE p.player_id = target.player_id RETURNING p.ship_id) UPDATE ships s SET sector_id = @{route_sector_a_id} FROM moved WHERE s.ship_id = moved.ship_id"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Refresh loop_player session (sector update)",
      "command": "auth.login",
      "user": "loop_player",
      "data": { "username": "loop_player", "passwd": "password" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Dock at the first selected port",
      "command": "dock.status",
      "user": "loop_player",
      "data": { "action": "dock" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Route Request (Still Empty - only 1 port known)",
      "command": "player.computer.recommend_routes",
      "user": "loop_player",
      "data": {},
      "expect": {
        "status": "ok",
        "data": {
          "routes": []
        }
      }
    },
    {
      "name": "Move test player and ship to the selected connected port",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "WITH target AS (SELECT player_id, ship_id FROM players WHERE name = 'loop_player'), moved AS (UPDATE players p SET sector_id = @{route_sector_b_id} FROM target WHERE p.player_id = target.player_id RETURNING p.ship_id) UPDATE ships s SET sector_id = @{route_sector_b_id} FROM moved WHERE s.ship_id = moved.ship_id"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Refresh loop_player session at the second port",
      "command": "auth.login",
      "user": "loop_player",
      "data": { "username": "loop_player", "passwd": "password" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Dock at the second selected port",
      "command": "dock.status",
      "user": "loop_player",
      "data": { "action": "dock" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Route Request (Should show the selected two-way port pair)",
      "command": "player.computer.recommend_routes",
      "user": "loop_player",
      "data": { "require_two_way": true },
      "expect": {
        "status": "ok",
        "data": {
        "routes": [
            {}
          ]
        }
      },
      "asserts": [
        { "path": "data.routes.0.is_two_way", "op": "==", "value": true },
        { "path": "data.routes.0.port_a_id", "op": ">", "value": 0 },
        { "path": "data.routes.0.port_b_id", "op": ">", "value": 0 },
        { "path": "data.routes.0.sector_a_id", "op": ">", "value": 0 },
        { "path": "data.routes.0.sector_b_id", "op": ">", "value": 0 },
        { "path": "data.routes.0.hops_between", "op": "==", "value": 1 },
        { "path": "data.routes.0", "op": "contains", "value": "approach_sector_id" },
        { "path": "data.routes.0", "op": "contains", "value": "port_a_name" },
        { "path": "data.routes.0", "op": "contains", "value": "port_b_name" },
        { "path": "data.routes.0", "op": "contains", "value": "commodity" },
        { "path": "data.routes.0", "op": "contains", "value": "a_to_b" },
        { "path": "data.routes.0", "op": "contains", "value": "b_to_a" },
        { "path": "data.routes.0", "op": "contains", "value": "estimated_profit_a_to_b" },
        { "path": "data.routes.0", "op": "contains", "value": "estimated_profit_b_to_a" }
      ]
    },
    {
      "name": "Recommendation response schema is discoverable",
      "command": "system.describe_schema",
      "user": "loop_player",
      "data": { "name": "player.computer.trade_routes", "type": "event" },
      "asserts": [
        { "path": "data.schema.properties.routes.items.properties.estimated_profit_a_to_b.type", "op": "==", "value": "integer" },
        { "path": "data.schema.properties.routes.items.properties.port_a_name.type", "op": "==", "value": "string" }
      ],
      "expect": { "status": "ok" }
    }
  ]
}
