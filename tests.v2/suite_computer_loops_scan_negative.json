{
  "test_suite_name": "Computer Trade Loops Negative Scan",
  "description": "Verifies that sector scans do NOT populate port knowledge for trade routes",
  "tests": [
    {
      "name": "Setup: Admin",
      "setup": "macro_bootstrap_admin"
    },
    {
      "name": "Register scan_player",
      "command": "auth.register",
      "user": "scan_player",
      "register_if_missing": true,
      "data": {
        "username": "scan_player",
        "passwd": "password"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Login scan_player",
      "command": "auth.login",
      "user": "scan_player",
      "data": {
        "username": "scan_player",
        "passwd": "password"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Initial Route Request (Empty)",
      "command": "player.computer.recommend_routes",
      "user": "scan_player",
      "data": {},
      "expect": {
        "status": "ok",
        "data": {
          "routes": [],
          "pathing_model": "full_graph",
          "truncated": false
        }
      }
    },
    {
      "name": "Rig: Choose a connected two-way port pair",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "SELECT p1.port_id, p1.sector_id, p2.port_id, p2.sector_id FROM sector_warps sw JOIN sector_warps back ON back.from_sector = sw.to_sector AND back.to_sector = sw.from_sector JOIN ports p1 ON p1.sector_id = sw.from_sector JOIN ports p2 ON p2.sector_id = sw.to_sector AND p2.port_id > p1.port_id JOIN port_trade pt1 ON pt1.port_id = p1.port_id JOIN port_trade pt2 ON pt2.port_id = p2.port_id AND pt2.commodity = pt1.commodity GROUP BY p1.port_id, p1.sector_id, p2.port_id, p2.sector_id, pt1.commodity HAVING SUM(CASE WHEN pt1.mode = 'sell' AND pt2.mode = 'buy' THEN 1 ELSE 0 END) > 0 AND SUM(CASE WHEN pt2.mode = 'sell' AND pt1.mode = 'buy' THEN 1 ELSE 0 END) > 0 ORDER BY p1.port_id, p2.port_id LIMIT 1"
      },
      "save": { "scan_origin_port_id": "data.rows.0.0", "scan_origin_sector": "data.rows.0.1", "scan_target_port_id": "data.rows.0.2", "scan_target_sector": "data.rows.0.3" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Teleport to selected origin sector",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": { "sql": "UPDATE players SET sector_id = @{scan_origin_sector} WHERE name = 'scan_player';" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Teleport active ship to selected origin sector",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": { "sql": "UPDATE ships SET sector_id = @{scan_origin_sector} WHERE ship_id = (SELECT ship_id FROM players WHERE name = 'scan_player');" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Refresh scan_player session",
      "command": "auth.login",
      "user": "scan_player",
      "data": { "username": "scan_player", "passwd": "password" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Scan selected origin sector",
      "command": "sector.scan",
      "user": "scan_player",
      "data": {},
      "expect": { "status": "ok" }
    },
    {
      "name": "Warp to the adjacent port sector",
      "command": "move.warp",
      "user": "scan_player",
      "data": { "to_sector_id": "@{scan_target_sector}" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Scan the adjacent port sector",
      "command": "sector.scan",
      "user": "scan_player",
      "data": {},
      "expect": { "status": "ok" }
    },
    {
      "name": "Route Request (Still Empty - Scans shouldn't add knowledge)",
      "command": "player.computer.recommend_routes",
      "user": "scan_player",
      "data": { "require_two_way": true },
      "expect": {
        "status": "ok",
        "data": {
          "routes": []
        }
      }
    },
    {
      "name": "Dock at the adjacent port (Now we know 1)",
      "command": "dock.status",
      "user": "scan_player",
      "data": { "action": "dock" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Warp back to selected origin sector",
      "command": "move.warp",
      "user": "scan_player",
      "data": { "to_sector_id": "@{scan_origin_sector}" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Dock at the origin port (Now we know 2)",
      "command": "dock.status",
      "user": "scan_player",
      "data": { "action": "dock" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Route Request (Should now show routes)",
      "command": "player.computer.recommend_routes",
      "user": "scan_player",
      "data": { "require_two_way": true },
      "expect": {
        "status": "ok",
        "data": {
          "routes": [
            {
              "port_a_id": "@{scan_origin_port_id}",
              "port_b_id": "@{scan_target_port_id}"
            }
          ],
          "pathing_model": "full_graph"
        }
      }
    }
  ]
}
