{
  "name": "Move Autopilot Start Suite",
  "tests": [
    {
      "name": "Setup: mover_autopilot",
      "setup": "macro_auth_user",
      "username": "mover_autopilot",
      "password": "password"
    },
    {
      "name": "Rig: Select a known outgoing autopilot route",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "SELECT p.sector_id, sw.to_sector FROM players p JOIN sector_warps sw ON sw.from_sector = p.sector_id WHERE p.player_id = @{mover_autopilot_player_id} ORDER BY sw.to_sector LIMIT 1;"
      },
      "expect": { "status": "ok" },
      "save": { "route_from": "data.rows.0.0", "route_to": "data.rows.0.1" }
    },
    {
      "name": "Positive: Start Autopilot",
      "command": "move.autopilot.start",
      "data": { "from_sector_id": "@{route_from}", "to_sector_id": "@{route_to}" },
      "user": "mover_autopilot",
      "expect": { "status": "ok" }
    },
    {
      "name": "Negative: Autopilot Start Missing Auth",
      "command": "move.autopilot.start",
      "data": { "from_sector_id": "@{route_from}", "to_sector_id": "@{route_to}" },
      "expect": { "status": "error", "error_code": 401 }
    }
  ]
}
