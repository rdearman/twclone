{
  "test_suite_name": "Subscription Commands",
  "description": "Tests subscribe.catalog, subscribe.list, subscribe.remove commands",
  "tests": [
    {
      "name": "Setup: User",
      "setup": "macro_auth_user",
      "username": "sub_user",
      "password": "password"
    },
    {
      "name": "Test subscribe.catalog command",
      "user": "sub_user",
      "command": "subscribe.catalog",
      "expect": { "status": "ok", "type": "subscribe.catalog_v1" },
      "asserts": [
        { "path": "data.topics", "op": "exists" },
        { "path": "data.topics", "op": "is_array" },
        { "path": "data.topics[?(@.pattern == 'system.notice')]", "op": "len_gt", "value": 0 },
        { "path": "data.topics[?(@.pattern == 'sector.*')]", "op": "len_gt", "value": 0 }
      ]
    },
    {
      "name": "Test subscribe.list includes the required system notice subscription",
      "user": "sub_user",
      "command": "subscribe.list",
      "expect": { "status": "ok", "type": "subscribe.list_v1" },
      "asserts": [
        { "path": "data", "op": "keys_eq", "value": ["topics"] },
        { "path": "data.topics", "op": "is_string_array" },
        { "path": "data.topics", "op": "contains", "value": "system.notice" }
      ]
    },
    {
      "name": "Add a subscription",
      "user": "sub_user",
      "command": "subscribe.add",
      "data": { "topic": "combat.*" },
      "expect": { "status": "ok", "type": "subscribe.ack_v1" },
      "asserts": [
        { "path": "data", "op": "keys_eq", "value": ["topic", "added"] },
        { "path": "data.topic", "op": "==", "value": "combat.*" },
        { "path": "data.added", "op": "==", "value": true }
      ]
    },
    {
      "name": "Test subscribe.list command with one subscription",
      "user": "sub_user",
      "command": "subscribe.list",
      "expect": { "status": "ok", "type": "subscribe.list_v1" },
      "asserts": [
        { "path": "data", "op": "keys_eq", "value": ["topics"] },
        { "path": "data.topics", "op": "is_string_array" },
        { "path": "data.topics", "op": "contains", "value": "combat.*" }
      ]
    },
    {
      "name": "Remove a subscription",
      "user": "sub_user",
      "command": "subscribe.remove",
      "data": { "topic": "combat.*" },
      "expect": { "status": "ok", "type": "subscribe.ack_v1" },
      "asserts": [
        { "path": "data", "op": "keys_eq", "value": ["topic", "removed"] },
        { "path": "data.topic", "op": "==", "value": "combat.*" },
        { "path": "data.removed", "op": "==", "value": true }
      ]
    },
    {
      "name": "Test subscribe.list command after removing subscription",
      "user": "sub_user",
      "command": "subscribe.list",
      "expect": { "status": "ok", "type": "subscribe.list_v1" },
      "asserts": [
        { "path": "data", "op": "keys_eq", "value": ["topics"] },
        { "path": "data.topics", "op": "is_string_array" },
        { "path": "data.topics", "op": "contains", "value": "system.notice" },
        { "path": "data.topics", "op": "contains", "value": "combat.*" }
      ]
    },
    {
      "name": "Test subscribe.remove is idempotent for a missing topic",
      "user": "sub_user",
      "command": "subscribe.remove",
      "data": { "topic": "sector.*" },
      "expect": { "status": "ok", "type": "subscribe.ack_v1" }
    }
  ]
}
