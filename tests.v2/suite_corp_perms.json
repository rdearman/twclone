{
  "tests": [
    {
      "name": "Setup: CEO User",
      "setup": "macro_auth_user",
      "username": "perms_ceo_user",
      "password": "password"
    },
    {
      "name": "Setup: Officer User",
      "setup": "macro_auth_user",
      "username": "perms_officer_user",
      "password": "password"
    },
    {
      "name": "Setup: Member User",
      "setup": "macro_auth_user",
      "username": "perms_member_user",
      "password": "password"
    },
    {
      "name": "Setup: Outsider User",
      "setup": "macro_auth_user",
      "username": "perms_outsider_user",
      "password": "password"
    },
    {
      "name": "Action: CEO Creates Corp (Assuming pre-rigged members for later)",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "UPDATE bank_accounts SET balance = 1000000 WHERE owner_type='player' AND owner_id = @{perms_ceo_user_player_id};" },
      "user": "admin",
      "expect": { "status": "ok" }
    },
    {
      "name": "Action: CEO Creates Corp",
      "command": "corp.create",
      "data": { "name": "PermsCorpV2" },
      "user": "perms_ceo_user",
      "save": { "corp_id": "data.corp_id" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Setup: Invite Officer",
      "command": "corp.invite",
      "data": { "target_player_id": "@perms_officer_user_player_id" },
      "user": "perms_ceo_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Setup: Officer Joins Corporation",
      "command": "corp.join",
      "data": { "corp_id": "@corp_id" },
      "user": "perms_officer_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Setup: Invite Member",
      "command": "corp.invite",
      "data": { "target_player_id": "@perms_member_user_player_id" },
      "user": "perms_ceo_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Setup: Member Joins Corporation",
      "command": "corp.join",
      "data": { "corp_id": "@corp_id" },
      "user": "perms_member_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Guard: Unauthorized Kick (Member kicks Officer)",
      "command": "corp.kick",
      "data": { "target_player_id": "@perms_officer_user_player_id" },
      "user": "perms_member_user",
      "expect": { "status": "error", "error_code": 402 }
    },
    {
      "name": "Guard: Unauthorized Kick (Outsider kicks Member)",
      "command": "corp.kick",
      "data": { "target_player_id": "@perms_member_user_player_id" },
      "user": "perms_outsider_user",
      "expect": { 
        "status": "error"
      }
    },
    {
      "name": "Action: CEO Kicks Member (Success - Note: Uses pre-rigged state or previous steps)",
      "command": "corp.kick",
      "data": { "target_player_id": "@perms_member_user_player_id" },
      "user": "perms_ceo_user",
      "expect": { 
        "status": "ok"
      }
    },
    {
      "name": "Guard: Transfer CEO (Non-CEO attempts)",
      "command": "corp.transfer_ceo",
      "data": { "target_player_id": "@perms_ceo_user_player_id" },
      "user": "perms_officer_user",
      "expect": { 
        "status": "error"
      }
    }
  ]
}
