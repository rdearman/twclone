{
  "tests": [
    {
      "name": "Setup: User",
      "setup": "macro_auth_user",
      "username": "session_user",
      "password": "password"
    },
    {
      "name": "System Hello",
      "command": "system.hello",
      "data": { "client_version": "0.0.0" },
      "expect": { "status": "ok" }
    },
    {
      "name": "System Capabilities",
      "command": "system.capabilities",
      "user": "session_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "System Command List",
      "command": "system.cmd_list",
      "user": "session_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "System Schema List",
      "command": "system.schema_list",
      "user": "session_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "System Describe Schema",
      "command": "system.describe_schema",
      "data": { "name": "auth.login", "type": "command" },
      "user": "session_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Player Ping",
      "command": "session.ping",
      "user": "session_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Auth Refresh rotates the bearer in auth.session",
      "command": "auth.refresh",
      "user": "session_user",
      "save": { "refreshed_session": "data.session_token" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Auth Refresh invalidates the prior token",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": { "sql": "SELECT COUNT(*) FROM sessions WHERE token = '@session';" },
      "asserts": [
        { "path": "data.rows.0.0", "op": "==", "value": 0 }
      ]
    },
    {
      "name": "Refreshed token authenticates player information",
      "command": "player.my_info",
      "user": "session_user",
      "expect": { "status": "ok" },
      "asserts": [
        { "path": "data.player.id", "op": "==", "value": "@session_user_player_id" },
        { "path": "data.player.username", "op": "==", "value": "session_user" }
      ]
    },
    {
      "name": "Auth Logout",
      "command": "auth.logout",
      "user": "session_user",
      "expect": { "status": "ok" }
    },
    {
      "name": "Verify Logout (Ping Fail)",
      "command": "player.my_info",
      "user": "session_user",
      "expect": { "status": "error", "error_code": 401 }
    },
    {
      "name": "Expire the admin session",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": { "sql": "UPDATE sessions SET expires = CURRENT_TIMESTAMP - INTERVAL '1 second' WHERE token = '@admin_session';" },
      "expect": { "status": "ok" }
    },
    {
      "name": "Expired session cannot call authenticated APIs",
      "command": "player.my_info",
      "user": "admin",
      "expect": { "status": "error", "error_code": 401 }
    }
  ]
}
