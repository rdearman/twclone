{
  "test_suite_name": "Planet Operations",
  "description": "Validates planet renaming and ownership transfer mechanics",
  "tests": [
    {
      "name": "Setup: Auth Lord",
      "setup": "macro_auth_user",
      "username": "planet_lord",
      "password": "password"
    },
    {
      "name": "Setup: Auth Heir",
      "setup": "macro_auth_user",
      "username": "planet_heir",
      "password": "password"
    },
    {
      "name": "Rig: Provision an owned planet for operations",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "UPDATE planets SET owner_id = @{planet_lord_player_id}, owner_type = 'player' WHERE planet_id = 1;"
      },
      "expect": { "status": "ok" }
    },
    {
      "name": "Planet: Rename (Success)",
      "command": "planet.rename",
      "user": "planet_lord",
      "data": {
        "planet_id": 1,
        "name": "Arrakis"
      },
      "expect": {
        "status": "planet.rename.success"
      }
    },
    {
      "name": "Planet: Transfer Ownership",
      "command": "planet.transfer_ownership",
      "user": "planet_lord",
      "data": {
        "planet_id": 1,
        "target_id": "@planet_heir_player_id",
        "target_type": "player"
      },
      "expect": {
        "status": "ok",
        "type": "planet.transfer_ownership.success"
      }
    }
  ]
}
