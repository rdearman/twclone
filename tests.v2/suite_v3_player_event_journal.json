{
  "name": "V3 player event journal and resume",
  "tests": [
    {
      "setup": "macro_auth_user",
      "username": "event_journal_user",
      "password": "password"
    },
    {
      "setup": "macro_auth_user",
      "username": "event_journal_other",
      "password": "password"
    },
    {
      "name": "Reset the dedicated journal fixture stream",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "WITH removed AS (DELETE FROM player_events WHERE player_id = @{event_journal_user_player_id} RETURNING 1), reset_stream AS (UPDATE player_event_streams SET last_sequence = 0, pruned_through_sequence = 0 WHERE player_id = @{event_journal_user_player_id} RETURNING player_id) SELECT COUNT(*) FROM reset_stream;"
      }
    },
    {
      "name": "Empty resume returns stable initial cursor",
      "command": "events.resume",
      "user": "event_journal_user",
      "save": { "event_journal_start": "data.next_cursor" },
      "expect": { "status": "ok" },
      "asserts": [
        { "path": "data.events", "op": "==", "value": [] },
        { "path": "data.has_more", "op": "==", "value": false }
      ]
    },
    {
      "name": "Seed two ordered durable events for the player's stream",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": {
        "sql": "WITH stream AS (SELECT player_id, stream_id FROM player_event_streams WHERE player_id = @{event_journal_user_player_id}), inserted AS (INSERT INTO player_events (event_id, player_id, stream_id, sequence, event_type, topic, payload) SELECT gen_random_uuid(), player_id, stream_id, 1, 'journal.regression.one', 'system.events', '{\"value\":1}'::jsonb FROM stream UNION ALL SELECT gen_random_uuid(), player_id, stream_id, 2, 'journal.regression.two', 'system.events', '{\"value\":2}'::jsonb FROM stream RETURNING sequence), updated AS (UPDATE player_event_streams SET last_sequence = 2 WHERE player_id = @{event_journal_user_player_id} RETURNING player_id) SELECT COUNT(*) FROM inserted;"
      },
      "asserts": [
        { "path": "data.rows.0.0", "op": "==", "value": 2 }
      ]
    },
    {
      "name": "First page is ordered and captures a high watermark",
      "command": "events.resume",
      "user": "event_journal_user",
      "data": { "after_cursor": "@event_journal_start", "limit": 1 },
      "save": {
        "event_journal_page1_cursor": "data.next_cursor",
        "event_journal_watermark": "data.high_watermark"
      },
      "expect": { "status": "ok" },
      "asserts": [
        { "path": "data.events.0.type", "op": "==", "value": "journal.regression.one" },
        { "path": "data.events.0.data.value", "op": "==", "value": 1 },
        { "path": "data.events.0.meta.replayable", "op": "==", "value": true },
        { "path": "data.has_more", "op": "==", "value": true }
      ]
    },
    {
      "name": "Next page round-trips its cursor and watermark",
      "command": "events.resume",
      "user": "event_journal_user",
      "data": {
        "after_cursor": "@event_journal_page1_cursor",
        "through_cursor": "@event_journal_watermark",
        "limit": 1
      },
      "expect": { "status": "ok" },
      "asserts": [
        { "path": "data.events.0.type", "op": "==", "value": "journal.regression.two" },
        { "path": "data.events.0.data.value", "op": "==", "value": 2 },
        { "path": "data.has_more", "op": "==", "value": false },
        { "path": "data.next_cursor", "op": "==", "value": "@event_journal_watermark" },
        { "path": "data.high_watermark", "op": "==", "value": "@event_journal_watermark" }
      ]
    },
    {
      "name": "Foreign stream cursor requires resynchronization",
      "command": "events.resume",
      "user": "event_journal_user",
      "data": {
        "after_cursor": "v1.00000000-0000-4000-8000-000000000001.1"
      },
      "expect": { "status": "error", "error_code": 1306 },
      "asserts": [
        { "path": "error.data.resync_required", "op": "==", "value": true }
      ]
    },
    {
      "name": "Invalid page limit preserves schema validation",
      "command": "events.resume",
      "user": "event_journal_user",
      "data": { "limit": 501 },
      "expect": { "status": "error", "error_code": 1300 }
    },
    {
      "name": "Other player stream starts independently",
      "command": "events.resume",
      "user": "event_journal_other",
      "expect": { "status": "ok" },
      "asserts": [
        { "path": "data.events", "op": "==", "value": [] },
        { "path": "data.high_watermark", "op": "contains", "value": "v1." }
      ]
    }
  ]
}
