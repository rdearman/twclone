{
  "name": "Bucket 1 Remainder - Tavern and Trade",
  "tests": [
    {
      "name": "Setup: trader_player_1",
      "setup": "macro_auth_user",
      "username": "trader_player_1",
      "password": "password"
    },
    {
      "name": "Setup: trader_player_2",
      "setup": "macro_auth_user",
      "username": "trader_player_2",
      "password": "password"
    },
    {
      "name": "Rig: Move Player to Sector 1",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "UPDATE players SET sector_id = 1 WHERE player_id = @{trader_player_1_player_id};" },
      "user": "admin",
      "expect": { "status": "ok" }
    },
    {
      "name": "Rig: Move Ship to Sector 1",
      "command": "sys.raw_sql_exec",
      "data": { "sql": "UPDATE ships SET sector_id = 1 WHERE ship_id = (SELECT ship_id FROM players WHERE player_id = @{trader_player_1_player_id});" },
      "user": "admin",
      "expect": { "status": "ok" }
    },
    { "name": "Rig: Clear trade offers", "command": "sys.raw_sql_exec", "data": { "sql": "DELETE FROM trade_offers WHERE sender_player_id = @{trader_player_1_player_id} AND idempotency_key IN ('bucket1-trade-sell', 'bucket1-trade-cancel');" }, "user": "admin", "expect": { "status": "ok" } },
    { "name": "Rig: Seed trade offer cargo", "command": "sys.raw_sql_exec", "data": { "sql": "INSERT INTO ship_cargo (ship_id, commodity_code, quantity) SELECT ship_id, 'ORE', 2 FROM players WHERE player_id = @{trader_player_1_player_id} ON CONFLICT (ship_id, commodity_code) DO UPDATE SET quantity = 2;" }, "user": "admin", "expect": { "status": "ok" } },
    { "name": "tavern.deadpool.place_bet - Positive", "command": "tavern.deadpool.place_bet", "data": { "target_id": 1, "amount": 100 }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.deadpool.place_bet - Negative (No Auth)", "command": "tavern.deadpool.place_bet", "data": { "target_id": 1, "amount": 100 }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.graffiti.post - Positive", "command": "tavern.graffiti.post", "data": { "text": "Hello" }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.graffiti.post - Negative (No Auth)", "command": "tavern.graffiti.post", "data": { "text": "Hello" }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.highstakes.play - Positive", "command": "tavern.highstakes.play", "data": { "bet": 100 }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.highstakes.play - Negative (No Auth)", "command": "tavern.highstakes.play", "data": { "bet": 100 }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.loan.pay - Positive", "command": "tavern.loan.pay", "data": { "amount": 100 }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.loan.pay - Negative (No Auth)", "command": "tavern.loan.pay", "data": { "amount": 100 }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.lottery.buy_ticket - Positive", "command": "tavern.lottery.buy_ticket", "data": { "count": 1 }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.lottery.buy_ticket - Negative (No Auth)", "command": "tavern.lottery.buy_ticket", "data": { "count": 1 }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.lottery.status - Positive", "command": "tavern.lottery.status", "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.lottery.status - Negative (No Auth)", "command": "tavern.lottery.status", "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.raffle.buy_ticket - Positive", "command": "tavern.raffle.buy_ticket", "data": { "count": 1 }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.raffle.buy_ticket - Negative (No Auth)", "command": "tavern.raffle.buy_ticket", "data": { "count": 1 }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.rumour.get_hint - Positive", "command": "tavern.rumour.get_hint", "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.rumour.get_hint - Negative (No Auth)", "command": "tavern.rumour.get_hint", "expect": { "status": "error", "error_code": 401 } },
    { "name": "tavern.trader.buy_password - Positive", "command": "tavern.trader.buy_password", "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "tavern.trader.buy_password - Negative (No Auth)", "command": "tavern.trader.buy_password", "expect": { "status": "error", "error_code": 401 } },
    { "name": "trade.offer - Positive", "command": "trade.offer", "data": { "to_player_id": "@{trader_player_2_player_id}", "commodity": "ORE", "quantity": 1, "price": 1, "mode": "sell", "idempotency_key": "bucket1-trade-sell" }, "user": "trader_player_1", "save": { "@bucket1_offer_id": "data.offer_id" }, "expect": { "status": "trade.offer.created_v1" } },
    { "name": "trade.offer - Negative (No Auth)", "command": "trade.offer", "data": { "to_player_id": "@{trader_player_2_player_id}", "commodity": "ORE", "quantity": 1, "price": 1, "mode": "sell", "idempotency_key": "bucket1-trade-no-auth" }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "trade.accept - Positive", "command": "trade.accept", "data": { "offer_id": "@{bucket1_offer_id}" }, "user": "trader_player_2", "expect": { "status": "trade.offer.accepted_v1" } },
    { "name": "trade.accept - Negative (No Auth)", "command": "trade.accept", "data": { "offer_id": "@{bucket1_offer_id}" }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "trade.offer - Create cancellable offer", "command": "trade.offer", "data": { "to_player_id": "@{trader_player_2_player_id}", "commodity": "ORE", "quantity": 1, "price": 1, "mode": "sell", "idempotency_key": "bucket1-trade-cancel" }, "user": "trader_player_1", "save": { "@bucket1_cancel_offer_id": "data.offer_id" }, "expect": { "status": "trade.offer.created_v1" } },
    { "name": "trade.cancel - Positive", "command": "trade.cancel", "data": { "offer_id": "@{bucket1_cancel_offer_id}" }, "user": "trader_player_1", "expect": { "status": "trade.offer.cancelled_v1" } },
    { "name": "trade.cancel - Negative (No Auth)", "command": "trade.cancel", "data": { "offer_id": "@{bucket1_cancel_offer_id}" }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "trade.history - Positive", "command": "trade.history", "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "trade.history - Negative (No Auth)", "command": "trade.history", "expect": { "status": "error", "error_code": 401 } },
    { "name": "trade.port_info - Positive", "command": "trade.port_info", "data": { "port_id": 1 }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "trade.port_info - Negative (No Auth)", "command": "trade.port_info", "data": { "port_id": 1 }, "expect": { "status": "error", "error_code": 401 } },
    {
      "name": "Rig: Find a local port buying ORE for sale test",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": { "sql": "SELECT p.port_id, p.sector_id FROM ports p JOIN port_trade pt ON pt.port_id = p.port_id WHERE pt.commodity = 'ORE' AND pt.mode = 'buy' LIMIT 1;" },
      "expect": { "status": "ok" },
      "save": { "ore_buyer_port_id": "data.rows.0.0", "ore_buyer_sector_id": "data.rows.0.1" }
    },
    {
      "name": "Rig: Position player and seed one ORE for sale",
      "command": "sys.raw_sql_exec",
      "user": "admin",
      "data": { "sql": "WITH moved_ship AS (UPDATE ships SET sector_id = @{ore_buyer_sector_id}, ore = 1 WHERE ship_id = (SELECT ship_id FROM players WHERE player_id = @{trader_player_1_player_id}) RETURNING ship_id) UPDATE players SET sector_id = @{ore_buyer_sector_id} WHERE player_id = @{trader_player_1_player_id};" },
      "expect": { "status": "ok" }
    },
    { "name": "trade.sell - Positive", "command": "trade.sell", "data": { "sector_id": "@{ore_buyer_sector_id}", "port_id": "@{ore_buyer_port_id}", "items": [{"commodity":"ORE","quantity":1}], "idempotency_key": "bucket1-trade-sell-*uuid*" }, "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "trade.sell - Negative (No Auth)", "command": "trade.sell", "data": { "sector_id": "@{ore_buyer_sector_id}", "port_id": "@{ore_buyer_port_id}", "items": [{"commodity":"ORE","quantity":1}], "idempotency_key": "bucket1-trade-sell-no-auth-*uuid*" }, "expect": { "status": "error", "error_code": 401 } },
    { "name": "port.info - Positive", "command": "port.info", "user": "trader_player_1", "expect": { "status": "ok" } },
    { "name": "port.info - Negative (No Auth)", "command": "port.info", "expect": { "status": "error", "error_code": 401 } }
  ]
}
