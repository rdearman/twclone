{
  "test_suite_name": "TLS Smoke Tests",
  "description": "Verify V3 JSON commands over a disposable TLS-enabled test server.",
  "config": {
    "tls": true,
    "tls_skip_verify": true
  },
  "tests": [
    {
      "name": "TLS: Login succeeds over TLS",
      "command": "auth.login",
      "user": "tls_smoke_system",
      "data": { "username": "System", "passwd": "BOT" },
      "expect": { "status": "ok", "type": "auth.login" }
    },
    {
      "name": "TLS: Authenticated player information works",
      "command": "player.my_info",
      "user": "tls_smoke_system",
      "expect": { "status": "ok" }
    },
    {
      "name": "TLS: Unknown command returns protocol error",
      "command": "test.unknown_command",
      "user": "tls_smoke_system",
      "expect": { "status": "error", "error_code": 1300 }
    },
    {
      "name": "TLS: Persistent connection accepts subsequent JSON request",
      "command": "player.my_info",
      "user": "tls_smoke_system",
      "expect": { "status": "ok" }
    }
  ]
}
