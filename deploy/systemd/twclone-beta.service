[Unit]
Description=TWClone V3 Beta Compose stack
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/twclone-beta/current
EnvironmentFile=/etc/twclone-beta/.env.beta
ExecStart=/usr/bin/docker compose -p twclone-beta -f compose.beta.yaml up -d --no-build
ExecStop=/usr/bin/docker compose -p twclone-beta -f compose.beta.yaml stop
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
